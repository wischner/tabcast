{
    // F5 debugging for Tabcast.
    //
    // Select the compound "Tabcast: daemon + client" for F5.
    // It builds all three parts, then starts Apostle
    // and Disciple together under gdb, so the extension has somewhere
    // to broadcast to and you can watch both ends.
    //
    // Needs the C/C++ extension (ms-vscode.cpptools). F5 builds have
    // debug symbols and undefined behaviour checks. The tasks select
    // UBSan because this host's AppProtection preload conflicts with
    // ASan. Normal make builds still enable both sanitizers.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug apostle",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/apostle",
            // Foreground, so its log lands in the integrated terminal
            // instead of the system journal.
            "args": ["--foreground", "--log-level", "debug"],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "build apostle",
            "environment": [
                {
                    // LeakSanitizer cannot run under gdb's ptrace.
                    // Address and undefined behaviour checks stay on.
                    "name": "ASAN_OPTIONS",
                    "value": "detect_leaks=0"
                }
            ],
            "setupCommands": [
                {
                    "description": "Pretty printing for the standard library",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Do not stop on the signals the daemon handles itself",
                    "text": "handle SIGTERM SIGINT SIGHUP nostop noprint pass",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug disciple",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/disciple",
            // Standalone preview. The compound uses the live client
            // below, without --replay.
            "args": [
                "--replay",
                "${workspaceFolder}/disciple/tests/data/sample-page.png"
            ],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "build disciple",
            "environment": [
                {
                    // LeakSanitizer cannot run under gdb's ptrace.
                    "name": "ASAN_OPTIONS",
                    "value": "detect_leaks=0"
                }
            ],
            "setupCommands": [
                {
                    "description": "Pretty printing for the standard library",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Debug disciple (no arguments)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin/disciple",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "preLaunchTask": "prepare live disciple",
            "environment": [
                {
                    "name": "ASAN_OPTIONS",
                    "value": "detect_leaks=0"
                }
            ],
            "setupCommands": [
                {
                    "description": "Pretty printing for the standard library",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ],
    "compounds": [
        {
            // Select this target in Run and Debug for end-to-end use.
            "name": "Tabcast: daemon + client",
            "configurations": ["Debug apostle", "Debug disciple (no arguments)"],
            "preLaunchTask": "build all",
            "stopAll": true,
            "presentation": { "group": "tabcast", "order": 1 }
        }
    ]
}
