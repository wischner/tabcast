{
    // Build task for Tabcast, used by F5.
    //
    // The top-level Makefile, in its Docker build image, building all
    // three parts with debug symbols and undefined behaviour checks.
    // UBSan only: ASan conflicts with the system-wide AppProtection
    // preload on the development machine. The programs land in bin/,
    // where the launch configurations run them from.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build all",
            "detail": "Extension, daemon, and reader emulator, debug. Used by F5.",
            "type": "shell",
            "command": "make",
            "args": ["-C", "${workspaceFolder}", "BUILD=debug", "SANITIZERS=undefined"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}
