{
    // Build tasks for the C++ parts of Tabcast. Both build the debug
    // configuration, which is the one with sanitizers and symbols, so
    // F5 always launches something debuggable.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build apostle",
            "type": "shell",
            "command": "make",
            "args": ["-C", "${workspaceFolder}/apostle", "BUILD=debug"],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build disciple",
            "type": "shell",
            "command": "make",
            "args": ["-C", "${workspaceFolder}/disciple", "BUILD=debug"],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "build all",
            "type": "shell",
            "command": "make",
            "args": ["-C", "${workspaceFolder}"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        }
    ]
}
