{
    // Build tasks for Tabcast.
    //
    // "build all" is the one F5 uses. It runs the top level Makefile,
    // which builds all three parts: the extension into
    // build/evangelist/, and the two C++ programs into bin/. Every
    // task builds the debug configuration, which is the one with
    // symbols and UBSan. ASan conflicts with the system-wide
    // AppProtection preload on the development machine. Normal make
    // builds still default to both address and undefined sanitizers.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build all",
            "detail": "Extension, daemon, and client. Used by F5.",
            "type": "shell",
            "command": "make",
            "args": ["-C", "${workspaceFolder}", "BUILD=debug", "BACKEND=test", "SANITIZERS=undefined"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "presentation": {
                "reveal": "silent",
                "panel": "shared",
                "clear": true
            }
        },
        {
            "label": "build apostle",
            "type": "shell",
            "command": "make",
            "args": ["-C", "${workspaceFolder}/apostle", "BUILD=debug", "SANITIZERS=undefined"],
            "group": "build",
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "silent", "panel": "shared" }
        },
        {
            "label": "build disciple",
            "type": "shell",
            "command": "make",
            "args": ["-C", "${workspaceFolder}/disciple", "BUILD=debug", "BACKEND=test", "SANITIZERS=undefined"],
            "group": "build",
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "silent", "panel": "shared" }
        },
        {
            "label": "prepare live disciple",
            "detail": "Build the windowed client and wait for Apostle's broadcast listener.",
            "type": "process",
            "command": "python3",
            "args": ["${workspaceFolder}/scripts/wait-for-apostle.py"],
            "dependsOn": "build disciple",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "dedicated" }
        },
        {
            "label": "build evangelist",
            "detail": "Rebuild the extension, then reload it in the browser.",
            "type": "shell",
            "command": "make",
            "args": ["-C", "${workspaceFolder}/evangelist"],
            "group": "build",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "test all",
            "type": "shell",
            "command": "make",
            "args": ["-C", "${workspaceFolder}", "check", "BUILD=debug", "SANITIZERS=undefined"],
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": ["$gcc"],
            "presentation": { "reveal": "always", "panel": "shared" }
        }
    ]
}
